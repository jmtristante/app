EXPO_PUBLIC_SUPABASE_URL=your-supabase-url
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Dropbox OAuth (https://www.dropbox.com/developers/apps)
EXPO_PUBLIC_DROPBOX_CLIENT_ID=your-dropbox-client-id
EXPO_PUBLIC_DROPBOX_REDIRECT_URI=your-dropbox-redirect-uri

# Google Drive OAuth (https://console.cloud.google.com/apis/credentials)
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id
EXPO_PUBLIC_GOOGLE_REDIRECT_URI=your-google-redirect-uri
